{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "m365-portfolio-starter": {
      "projectType": "application",
      "schematics": {"@schematics/angular:component": {"style": "css"}},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/m365-portfolio-starter",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "src/assets", "output": "assets"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {"optimization": true, "outputHashing": "all"},
            "development": {"optimization": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {"builder": "@angular/build:dev-server", "configurations": {"production": {"buildTarget": "m365-portfolio-starter:build:production"}, "development": {"buildTarget": "m365-portfolio-starter:build:development"}}, "defaultConfiguration": "development"}
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
